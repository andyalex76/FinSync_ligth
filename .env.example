# ============================================================
# FinSync — Конфигурация окружения (.env.example)
# ============================================================

# ---------- Общие настройки ----------
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
TZ=Europe/Moscow

# ---------- Домен и сетевой доступ ----------
DOMAIN_NAME=finance.yourdomain.ru
# APP_URL: URL размещения веб-приложения (в AI Studio инжектируется автоматически)
APP_URL=https://finance.yourdomain.ru

# ---------- PostgreSQL (База данных) ----------
POSTGRES_DB=family_budget
POSTGRES_USER=budget_admin
POSTGRES_PASSWORD=generate_super_strong_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ---------- Redis (Очереди задач и кэш) ----------
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_URL=redis://:generate_strong_redis_password_here@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Telegram-бот (aiogram 3) ----------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321
TELEGRAM_BOT_MODE=long_polling
# TELEGRAM_WEBHOOK_URL=https://finance.yourdomain.ru/webhook/telegram
# TELEGRAM_WEBHOOK_SECRET=

# ---------- JWT / Аутентификация сессий ----------
SECRET_KEY=generate_random_64_character_hex_key_here
# Обязательно сгенерируйте: openssl rand -hex 32
ADMIN_TOKEN=generate_strong_admin_token_here
# Внутренний секрет межсервисного взаимодействия backend <-> ocr_worker
INTERNAL_API_KEY=generate_strong_internal_api_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ---------- Хранилище файлов и сканов чеков ----------
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,tiff,pdf

# ---------- OCR (Tesseract / Распознавание чеков) ----------
OCR_ENGINE=tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata/
OCR_LANGUAGES=rus+eng
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=60

# ---------- Валюты и курсы ----------
BASE_CURRENCY=RUB
SUPPORTED_CURRENCIES=RUB,USD,EUR
EXCHANGE_RATE_PROVIDER=cbr
EXCHANGE_RATE_CACHE_HOURS=6

# ---------- Frontend / PWA (Vite сборка) ----------
VITE_API_BASE_URL=https://finance.yourdomain.ru/api
VITE_WS_URL=wss://finance.yourdomain.ru/ws
VITE_APP_NAME=FinSync
VITE_APP_SHORT_NAME=FinSync
VITE_THEME_COLOR=#0f172a
VITE_BACKGROUND_COLOR=#ffffff

# ---------- CORS и безопасность API ----------
CORS_ORIGINS=https://finance.yourdomain.ru,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ---------- Резервное копирование (Cron & Дампы) ----------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups
# BACKUP_ENCRYPTION_KEY=

# ---------- Опционально: Push-уведомления PWA (VAPID) ----------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.ru
